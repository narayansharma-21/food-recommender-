{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recommendation-training-example-v1",
  "title": "Recommendation training example v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recommendationResultId",
    "ratingId",
    "userId",
    "restaurantId",
    "menuItemId",
    "dishConceptId",
    "recommendedAt",
    "ratedAt",
    "mode",
    "algorithmVersion",
    "featureVersion",
    "rank",
    "personalPreference",
    "popularity",
    "tasteEvidenceCount",
    "popularityRatingCount",
    "previouslyRated",
    "ratingScore",
    "wouldOrderAgain"
  ],
  "properties": {
    "schemaVersion": { "const": "recommendation-training-example-v1" },
    "recommendationResultId": { "type": "string", "format": "uuid" },
    "ratingId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "restaurantId": { "type": "string", "format": "uuid" },
    "menuItemId": { "type": "string", "format": "uuid" },
    "dishConceptId": { "type": ["string", "null"], "format": "uuid" },
    "recommendedAt": { "type": "string", "format": "date-time" },
    "ratedAt": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["SAFE_BET", "TRY_SOMETHING_NEW"] },
    "algorithmVersion": { "type": "string", "minLength": 1 },
    "featureVersion": { "type": "string", "minLength": 1 },
    "rank": { "type": "integer", "minimum": 1 },
    "personalPreference": { "type": "number", "minimum": -1, "maximum": 1 },
    "popularity": { "type": "number", "minimum": 0, "maximum": 1 },
    "tasteEvidenceCount": { "type": "integer", "minimum": 0 },
    "popularityRatingCount": { "type": "integer", "minimum": 0 },
    "previouslyRated": { "type": "boolean" },
    "ratingScore": { "type": "integer", "minimum": 1, "maximum": 5 },
    "wouldOrderAgain": { "type": ["boolean", "null"] }
  }
}
